@using FERNGSolver.Common.Presentation.Interfaces

@if (Columns == null || Rows == null || ValidRows.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">結果はありません。</MudAlert>
}
else
{
    <MudTable T="object" Items="@ValidRows" Hover="true" Dense="true" Bordered="true" Striped="true"
              Breakpoint="Breakpoint.Sm" Class="mt-4" OnRowClick="HandleRowClick">
        <HeaderContent>
            @foreach (var column in Columns)
            {
                <MudTh>@column.HeaderText</MudTh>
            }
        </HeaderContent>
        <RowTemplate Context="row">
            @foreach (var column in Columns)
            {
                <MudTd DataLabel="@column.HeaderText">@GetValue(row, column.PropertyName)</MudTd>
            }
        </RowTemplate>
    </MudTable>
}

@code {
    /// <summary>
    /// 表示する列情報を取得または設定します。
    /// </summary>
    [Parameter]
    public IReadOnlyList<ITableColumn>? Columns { get; set; }

    /// <summary>
    /// 表示する行（ViewModel）のリストを取得または設定します。
    /// <para> * 検索結果の生成元仕様により、100件目以降はnullが含まれる場合があるため、描画時に読み飛ばします。</para>
    /// </summary>
    [Parameter]
    public IReadOnlyList<object>? Rows { get; set; }

    /// <summary>
    /// 行がクリックされた時に呼び出されるコールバックを取得または設定します。
    /// <para> * 呼び出し元が特定の用途（RNGビューアへの追加など）に使うためのフックです。指定しなければ何も起こりません。</para>
    /// </summary>
    [Parameter]
    public EventCallback<object> OnRowClick { get; set; }

    private IReadOnlyList<object> ValidRows =>
        Rows?.Where(row => row != null).ToList() ?? new List<object>();

    private Task HandleRowClick(MudBlazor.TableRowClickEventArgs<object> args) => OnRowClick.InvokeAsync(args.Item);

    private static object? GetValue(object row, string propertyName)
    {
        return row.GetType().GetProperty(propertyName)?.GetValue(row);
    }
}

