@using FERNGSolver.Radiance.UI.Blazor.Internal

<MudText Typo="Typo.subtitle2" Class="mb-2">キャラクター選択による自動入力（任意）</MudText>
<MudGrid Class="mb-2">
    <MudItem xs="12" sm="6">
        <MudSelect T="int" @bind-Value="State.SelectedCharacterIndex" @bind-Value:after="RefreshGrowthRate" Label="キャラクター" Variant="Variant.Outlined">
            @for (var i = 0; i < State.Characters.Count; i++)
            {
                var index = i;
                <MudSelectItem T="int" Value="@index">@State.Characters[index].Name</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>
<div class="d-flex flex-wrap gap-2 mb-4">
    <MudCheckBox T="bool" @bind-Value="State.HasSwordBand" @bind-Value:after="RefreshGrowthRate" Label="剣士の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasFighterBand" @bind-Value:after="RefreshGrowthRate" Label="戦士の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasArcherBand" @bind-Value:after="RefreshGrowthRate" Label="弓兵の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasKnightBand" @bind-Value:after="RefreshGrowthRate" Label="重歩兵の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasPaladinBand" @bind-Value:after="RefreshGrowthRate" Label="騎士の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasPegasusBand" @bind-Value:after="RefreshGrowthRate" Label="天馬騎士の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasWyvernBand" @bind-Value:after="RefreshGrowthRate" Label="竜騎士の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasMageBand" @bind-Value:after="RefreshGrowthRate" Label="魔道士の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasPriestBand" @bind-Value:after="RefreshGrowthRate" Label="神官の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasThiefBand" @bind-Value:after="RefreshGrowthRate" Label="盗賊の腕輪" Dense="true" />
    <MudCheckBox T="bool" @bind-Value="State.HasKnightWard" @bind-Value:after="RefreshGrowthRate" Label="騎士の護り" Dense="true" />
</div>

<MudText Typo="Typo.body2" Class="mb-2">
    各能力の成長率（%）と、「上昇が必要」かどうかを指定してください。チェックを外すと、その能力の上昇有無は考慮されません。
</MudText>

<MudGrid Class="mb-2">
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="State.HpGrowthRate" @bind-Value:after="NotifyChanged" Label="HP成長率" Variant="Variant.Outlined" />
        <MudCheckBox T="bool" @bind-Value="State.RequiresHpUp" @bind-Value:after="NotifyChanged" Label="上昇が必要" Dense="true" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="State.StrGrowthRate" @bind-Value:after="NotifyChanged" Label="力成長率" Variant="Variant.Outlined" />
        <MudCheckBox T="bool" @bind-Value="State.RequiresStrUp" @bind-Value:after="NotifyChanged" Label="上昇が必要" Dense="true" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="State.MgcGrowthRate" @bind-Value:after="NotifyChanged" Label="魔力成長率" Variant="Variant.Outlined" />
        <MudCheckBox T="bool" @bind-Value="State.RequiresMgcUp" @bind-Value:after="NotifyChanged" Label="上昇が必要" Dense="true" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="State.TecGrowthRate" @bind-Value:after="NotifyChanged" Label="技成長率" Variant="Variant.Outlined" />
        <MudCheckBox T="bool" @bind-Value="State.RequiresTecUp" @bind-Value:after="NotifyChanged" Label="上昇が必要" Dense="true" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="State.SpdGrowthRate" @bind-Value:after="NotifyChanged" Label="速さ成長率" Variant="Variant.Outlined" />
        <MudCheckBox T="bool" @bind-Value="State.RequiresSpdUp" @bind-Value:after="NotifyChanged" Label="上昇が必要" Dense="true" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="State.LucGrowthRate" @bind-Value:after="NotifyChanged" Label="幸運成長率" Variant="Variant.Outlined" />
        <MudCheckBox T="bool" @bind-Value="State.RequiresLucUp" @bind-Value:after="NotifyChanged" Label="上昇が必要" Dense="true" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="State.DefGrowthRate" @bind-Value:after="NotifyChanged" Label="守備成長率" Variant="Variant.Outlined" />
        <MudCheckBox T="bool" @bind-Value="State.RequiresDefUp" @bind-Value:after="NotifyChanged" Label="上昇が必要" Dense="true" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudNumericField T="int" @bind-Value="State.MdfGrowthRate" @bind-Value:after="NotifyChanged" Label="魔防成長率" Variant="Variant.Outlined" />
        <MudCheckBox T="bool" @bind-Value="State.RequiresMdfUp" @bind-Value:after="NotifyChanged" Label="上昇が必要" Dense="true" />
    </MudItem>
</MudGrid>

@code {
    /// <summary>
    /// このパネルが編集するレベルアップ条件の状態を取得または設定します。
    /// <para> * 呼び出し元（<see cref="FERNGSolver.Radiance.UI.Blazor.RadianceSearchForm"/>）と状態を共有するため、参照型のまま受け渡します。</para>
    /// </summary>
    [Parameter, EditorRequired]
    public GrowthConditionState State { get; set; } = null!;

    [Parameter]
    public EventCallback ConditionChanged { get; set; }

    private Task NotifyChanged() => ConditionChanged.InvokeAsync();

    private async Task RefreshGrowthRate()
    {
        State.RefreshGrowthRates();
        await NotifyChanged();
    }
}
